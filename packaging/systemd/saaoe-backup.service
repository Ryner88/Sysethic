[Unit]
Description=Consistent SysEthic SQLite snapshot and release pair
OnFailure=saaoe-backup-alert.service

[Service]
Type=oneshot
User=saaoe
Group=saaoe
WorkingDirectory=/opt/saaoe
ExecStart=/opt/saaoe/venv/bin/python -B /usr/local/lib/saaoe/saaoe_recovery.py backup --database /opt/saaoe/data/saaoe.db --repo /opt/saaoe --output /var/lib/saaoe-backups --python /opt/saaoe/venv/bin/python
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/saaoe-backups
ReadOnlyPaths=/opt/saaoe
InaccessiblePaths=/opt/saaoe/.env
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
